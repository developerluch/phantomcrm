{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode gzip
	# The renderer uses HashRouter, but fall back to index.html for any deep link.
	try_files {path} /index.html
	file_server
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
