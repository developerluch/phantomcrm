{
  "name": "@phantomcrm/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phantom CRM Electron desktop client",
  "author": "developerluch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerluch/phantomcrm.git",
    "directory": "apps/desktop"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:native": "bash electron/native/fn-monitor/build.sh",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "npm run build:native && npm run build && electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win",
    "lint:ui": "node scripts/check-shadcn-ui.mjs",
    "lint": "tsc --noEmit && npm run lint:ui",
    "test": "node scripts/test-localstorage-migration.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.11",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "exceljs": "3.10.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.400.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.0",
    "react-grid-layout": "^2.2.4",
    "react-hook-form": "^7.87.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.12.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^2.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "concurrently": "^8.2.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "shadcn": "^4.21.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.phantomcrm.dashboard",
    "productName": "Phantom CRM",
    "protocols": {
      "name": "Phantom Auth",
      "schemes": [
        "vipa"
      ]
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "electron/niprVerificationWindow.js"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "developerluch",
      "repo": "phantomcrm"
    },
    "mac": {
      "extraResources": [
        {
          "from": "electron/native/bin/fn-monitor",
          "to": "fn-monitor"
        }
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    }
  }
}
