# Public renderer configuration only. Copy to .env and fill in local values.
# Provider secrets belong in apps/api/.env, never in a VITE_ variable.

# API routing
VITE_API_URL=
VITE_PROXY_TARGET=

# Hosted web build only (staging preview). Never set for packaged Electron builds.
# Tokens are kept in sessionStorage instead of Electron's secure storage.
VITE_WEB_MODE=

# OAuth
VITE_DISCORD_CLIENT_ID=
VITE_DISCORD_REDIRECT_URI=
VITE_DISCORD_INVITE_URL=
VITE_GOOGLE_CLIENT_ID=
