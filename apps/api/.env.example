# Required API configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/phantomcrm?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-bytes
DISCORD_TOKEN=
GUILD_ID=
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Legacy service-to-service token. Leave unset unless a trusted integration
# still requires it; authenticated users should use JWTs.
API_TOKEN=

# OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# Email and AI
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Phantom CRM
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2

# Messaging providers
DEFAULT_SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_NUMBER=
TELNYX_API_KEY=
