# Automation safety defaults
PURGE_ENABLED=false
INACTIVITY_KICK_WEEKS=0
UNLICENSED_KICK_DAYS=0
UNLICENSED_WARN_DAYS=15,30,45,59
CHECKIN_DAY=1
CHECKIN_HOUR=9
NUDGE_AFTER_DAYS=30
APPROVAL_MODE=manual

