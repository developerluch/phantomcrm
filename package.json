{
  "name": "phantomcrm",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Phantom CRM desktop client and Go API monorepo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerluch/phantomcrm.git"
  },
  "bugs": {
    "url": "https://github.com/developerluch/phantomcrm/issues"
  },
  "homepage": "https://github.com/developerluch/phantomcrm#readme",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@phantomcrm/desktop",
    "build": "npm run build --workspace=@phantomcrm/desktop",
    "lint": "npm run lint --workspace=@phantomcrm/desktop",
    "test": "npm run test:desktop && npm run test:api",
    "test:desktop": "npm run test --workspace=@phantomcrm/desktop",
    "test:api": "cd apps/api && go test ./...",
    "vet:api": "cd apps/api && go vet ./...",
    "build:api": "mkdir -p .build && cd apps/api && go build -o ../../.build/phantomcrm-api ./cmd/api",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run build && npm run test && npm run vet:api && npm run build:api && npm run audit"
  }
}
